# Configuración de Entorno - Hospital Sanitas
SECRET_KEY=sanitas_super_secret_key_change_in_production_2026
ENVIRONMENT=development
# Formato PostgreSQL: postgresql+psycopg2://usuario:password@localhost:5432/sanitas_db
# Para desarrollo rápido local se puede usar SQLite o PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sanitas_db
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
